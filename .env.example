# Copy this to `.env` and you can build without editing anything:
#
#   cp .env.example .env && pnpm install && pnpm build:vendor && pnpm build
#
# The public values below are bundled into release builds and are not credentials.
# Never put tokens or secrets in a `VITE_` variable. Additional optional build
# settings are read in src/lib/env.ts, src/signal/config.ts and wxt.config.ts.

# Backend base URL. Every API request goes here.
VITE_KAITO_API_BASE_URL=https://hub.kaito.ai

# The Kaito web-app origin. Its sign-in route is fixed at /login, and it is the
# only frontend origin allowed to message the extension. Use http://localhost:3000
# when running the web app locally.
VITE_KAITO_CONNECT_URL=https://kaito.ai

# `production` or `dev`. `dev` turns on verbose logging and the debug panels.
# It does NOT decide the extension id. Every build from this repo is pinned to
# clfgaheindkfogpfcneoihannkgkhmna regardless of this value. Only the upload
# artifact (`pnpm zip:upload`) has no key. Nothing about the id belongs in this
# file, and Chrome cannot load two extensions with the same id at once.
VITE_KAITO_ENV=production
