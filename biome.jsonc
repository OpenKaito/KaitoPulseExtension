{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",

  // Biome replaces both a formatter and a linter here. ESLint is not an option
  // in this repository: typescript@7 is the native (Go) compiler, whose package
  // exports no JavaScript compiler API, and typescript-eslint refuses to load
  // against it outright — "typescript-eslint does not support TS 7.0", tracked at
  // https://github.com/typescript-eslint/typescript-eslint/issues/10940
  // Biome parses TypeScript itself, so it is unaffected — and it covers the CSS
  // in src/, which nothing linted before.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },

  "files": {
    "includes": [
      "src/**",
      "modules/**",
      "scripts/**/*.{ts,mjs}",
      "wxt.config.ts",
      // Generated by `wxt prepare`; not ours to format.
      "!src/remote-inline.d.ts"
    ]
  },

  // Matches what the tree already was before the first sweep: two-space
  // indent, semicolons, single quotes in TS (677 imports to 207), double
  // quotes in JSX (1128 to 0). lineWidth 100 sits just above the measured
  // p99 of 110 while keeping the sweep to ~10.6k lines.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },

  "css": { "formatter": { "enabled": true, "quoteStyle": "single" } },

  // Left off deliberately. The import order in files like signal/orchestrator.ts
  // groups by concern rather than alphabetically, and that reads better than
  // sorted; turning this on would rewrite 770 more lines to no benefit.
  "assist": { "actions": { "source": { "organizeImports": "off" } } },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,

      // This is an overlay injected into x.com. These rules are reporting real
      // gaps in keyboard and screen-reader support for the injected panels, but
      // closing them is product work, not a lint config decision, so they stay
      // visible at `info` instead of blocking a commit.
      "a11y": {
        "noStaticElementInteractions": "info",
        "useKeyWithClickEvents": "info",
        "useSemanticElements": "info",
        "useFocusableInteractive": "info",
        "useAriaPropsSupportedByRole": "info",
        // The inline icons are decorative. The fix the rule wants (a <title>
        // on each) would make screen readers announce 25 meaningless labels;
        // aria-hidden is the correct treatment and the rule cannot see it.
        "noSvgWithoutTitle": "off"
      },

      "style": {
        // Solid refs (`let el!: HTMLDivElement`) and DOM lookups use `!`
        // throughout by design.
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "warn"
      },

      "complexity": {
        // A content script has to outrank x.com's own stylesheet; !important
        // is load-bearing here, not laziness.
        "noImportantStyles": "off"
      },

      // Everything below was an error on the recommended set. Each one was read
      // against the source before being downgraded: none of them is a bug, so
      // none of them should be able to fail a commit. They stay at `warn` so
      // new instances are still visible in review.
      "correctness": {
        // twitter-main.content.ts casts the original XHR method to
        // `(...a: unknown[]) => void` and does `return fn.apply(...)`. That is
        // the ordinary monkey-patch passthrough.
        "noVoidTypeReturn": "warn"
      },

      "suspicious": {
        "noExplicitAny": "warn",
        // `.forEach((node) => node.remove())` — arrow shorthand whose callee
        // happens to return void.
        "useIterableCallbackReturn": "warn",
        // `this.fpPromise ??= collect().then((v) => (this.fp = v))` in
        // attention/content-buffer.ts is a deliberate memoisation.
        "noAssignInExpressions": "warn",
        "noImplicitAnyLet": "warn",
        // A local `const valueOf` in a Solid component shadows nothing that
        // matters; the rule only sees the name.
        "noShadowRestrictedNames": "warn"
      }
    }
  }
}
