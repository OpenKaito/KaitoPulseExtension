{
  "name": "kaito-extension",
  "version": "1.0.10",
  "private": true,
  "description": "Kaito Pulse Chrome extension for zkTLS verification and X signals",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKaito/KaitoPulseExtension.git"
  },
  "bugs": {
    "url": "https://github.com/OpenKaito/KaitoPulseExtension/issues"
  },
  "homepage": "https://github.com/OpenKaito/KaitoPulseExtension#readme",
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": "22.23.1",
    "pnpm": "9.10.0"
  },
  "scripts": {
    "prepare": "wxt prepare",
    "postinstall": "bash scripts/setup-vendor-config.sh && bash scripts/setup-git-hooks.sh",
    "build:vendor": "bash scripts/build-vendor.sh",
    "dev": "bash scripts/ensure-vendor.sh && wxt",
    "build": "bash scripts/ensure-vendor.sh && wxt build",
    "zip": "bash scripts/ensure-vendor.sh && wxt zip",
    "zip:dev": "bash scripts/ensure-vendor.sh && wxt zip --mode development",
    "zip:upload": "bash scripts/ensure-vendor.sh && UNPINNED_EXTENSION_ID=1 wxt zip",
    "release": "bash scripts/release.sh",
    "release:preflight": "bash scripts/release-preflight.sh",
    "publish:oss": "bash scripts/publish-oss.sh",
    "check:public-source": "bash scripts/check-public-source.sh",
    "test:hygiene": "bash scripts/check-public-source.test.sh",
    "test:release": "bash scripts/release.test.sh",
    "test:publish": "bash scripts/publish-oss.test.sh",
    "test:preflight": "bash scripts/release-preflight.test.sh",
    "test:unit": "node --test test/*.test.ts",
    "test:gates": "pnpm test:hygiene && pnpm test:release && pnpm test:publish && pnpm test:preflight",
    "verify:artifacts": "node scripts/verify-artifact-equivalence.mjs",
    "verify:no-mocks": "node scripts/assert-no-mocks.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "clean": "rm -rf dist .wxt .output"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/chrome": "^0.3.5",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-solid": "^1.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@zumer/snapdom": "^3.3.6",
    "echarts": "6.1.0",
    "json-formatter-js": "^2.5.23",
    "solid-js": "^1.9.17"
  },
  "pnpm": {
    "overrides": {
      "fx-runner>shell-quote": "^1.9.0",
      "web-ext-run>firefox-profile": "4.7.1",
      "web-ext-run>tmp": "^0.2.6"
    }
  }
}
